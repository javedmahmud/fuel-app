# Names and placeholder values only — never real credentials.
# Per 13_OBSERVABILITY_SECURITY_PRIVACY.md §13.8: real values live in Railway environment
# variables (deployed) or a git-ignored local .env (dev/staging-CLI use), never here, never
# committed, never pasted into an AI prompt.
#
# Full descriptions: claude-doco-v3/14_DEPLOYMENT.md §14.4.
# Most of these aren't consumed by any code yet (foundation branch) — listed now so the
# eventual shape is visible from day one, per feature/db-schema and feature/fuel-api-adapter.

DATABASE_URL=postgres://user:password@host:5432/dbname

# worker only — web never receives these (see §14.4's note on why)
FUEL_API_CONSUMER_KEY=
FUEL_API_CONSUMER_SECRET=
FUEL_API_BASE_URL=https://api.onegov.nsw.gov.au
FUEL_API_VERSION=v2

INGESTION_ENABLED=false
ENVIRONMENT_NAME=development
API_MONTHLY_BUDGET=2250
POLL_INTERVAL_MINUTES=60

LLM_EXPLANATION_ENABLED=false
ANTHROPIC_API_KEY=

FRESHNESS_THRESHOLDS_JSON={}
DEFAULT_CONSUMPTION_L_100KM=8.5
REFERENCE_FILL_LITRES=40

SENTRY_DSN=
LOG_LEVEL=debug
